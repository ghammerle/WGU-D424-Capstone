<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="C424Assessment.Views.CourseReport">
    <VerticalStackLayout>
        <Label Text="Course Report"
               FontSize="18"
               FontAttributes="Bold" />
            <CollectionView  x:Name="CourseCollection">
                <CollectionView.Header>
                    <Grid ColumnDefinitions="Auto,2*,1*" ColumnSpacing="10"
              Padding="5"
              BackgroundColor="#1976d2">
                    <Label Text="Name" TextColor="White" MinimumWidthRequest="200" MaximumWidthRequest="200"/>
                    <Label Text="Major" TextColor="White" Grid.Column="1" MinimumWidthRequest="80"/>
                    <Label Text="Enrolled" TextColor="White" Grid.Column="2" MaximumWidthRequest="60"/>
                    </Grid>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                    <Grid ColumnDefinitions="Auto,2*,1*" Padding="5" ColumnSpacing="10">
                        <Label Text="{Binding Name}" MinimumWidthRequest="200" MaximumWidthRequest="200"/>
                        <Label Text="{Binding Major}" Grid.Column="1" MinimumWidthRequest="80"/>
                            <Label Text="{Binding Enrolled}" Grid.Column="2" MaximumWidthRequest="60"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
    </VerticalStackLayout>
</ContentView>
