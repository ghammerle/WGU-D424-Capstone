<?xml version="1.0" encoding="utf-8" ?>
<view:BaseContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:C424Assessment.Views"
              xmlns:controls="clr-namespace:C424Assessment.Controls"
             x:Class="C424Assessment.Views.EditCreateStudentPage"
             Title="Edit or Create Student">
    <VerticalStackLayout>
        <Label 
            Text="Select Student:"
            FontAttributes="Bold"
            FontSize="18"
            VerticalOptions="Start" 
            HorizontalOptions="Center" />
        <Picker x:Name="StudentPicker"
                SelectedIndexChanged="StudentPicker_SelectedIndexChanged"
                Title="Select Student"
                HorizontalTextAlignment="Center"/>
        <Label 
            Text="First Name:"
            VerticalOptions="Center" 
            HorizontalOptions="Start" 
            FontAttributes="Bold"
            FontSize="16"/>
        <Border Padding="5" StrokeThickness="2" Margin="5">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10,10,10,10" />
            </Border.StrokeShape>
            <Entry x:Name="FirstNameEntry" Placeholder="Enter first name"/>
        </Border>
        <Label 
            Text="Last Name:"
            VerticalOptions="Center" 
            HorizontalOptions="Start" 
            FontAttributes="Bold"
            FontSize="16"/>
        <Border Padding="5" StrokeThickness="2" Margin="5">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10,10,10,10" />
            </Border.StrokeShape>
            <Entry x:Name="LastNameEntry" Placeholder="Enter last name"/>
        </Border>
        <Label 
            Text="Major:"
            VerticalOptions="Center" 
            HorizontalOptions="Start" 
            FontAttributes="Bold"
            FontSize="16"/>
        <Picker x:Name="MajorPicker" Title="Select Major"/>
        <Label 
            Text="StartDate:"
            VerticalOptions="Center" 
            HorizontalOptions="Start" 
            FontAttributes="Bold"
            FontSize="16"/>
        <DatePicker x:Name="DatePicker" DateSelected="DatePicker_DateSelected"/>
        <HorizontalStackLayout>
            <Label 
            Text="Reset Password:"
            VerticalOptions="Center" 
            HorizontalOptions="Start" 
            FontAttributes="Bold"
            FontSize="16"/>
            <CheckBox x:Name="ResetPasswordCB" Margin="5" IsChecked="True"/>
        </HorizontalStackLayout>
        <controls:ButtonView x:Name="FinishButtons"
                             OnCancel="FinishButtons_OnCancel"
                             OnDelete="FinishButtons_OnDelete"
                             OnSave="FinishButtons_OnSave"/>
    </VerticalStackLayout>
</view:BaseContentPage>