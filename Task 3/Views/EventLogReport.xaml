<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="C424Assessment.Views.EventLogReport"
            >
    <VerticalStackLayout>
        <Label Text="Event Log"
        FontSize="18"
        FontAttributes="Bold" />
        <CollectionView  x:Name="EventLogCollection">
            <CollectionView.Header>
                <Grid ColumnDefinitions="50,200,50,200"
       Padding="5"
       BackgroundColor="#1976d2">
                    <Label Text="Id" TextColor="White" />
                    <Label Text="TimeStamp" TextColor="White" Grid.Column="1" />
                    <Label Text="UserId" TextColor="White" Grid.Column="2" />
                    <Label Text="Event" TextColor="White" Grid.Column="3" />
                </Grid>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="50,200,50,200" Padding="5">
                        <Label Text="{Binding Id}" />
                        <Label Text="{Binding EventDateTime}" Grid.Column="1" />
                        <Label Text="{Binding UserId}" Grid.Column="2" />
                        <Label Text="{Binding EventDescription}" Grid.Column="3" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>