<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="C424Assessment.Controls.InstructorView">
    <ContentView.GestureRecognizers>
    </ContentView.GestureRecognizers>
    <VerticalStackLayout Padding="10">
        <HorizontalStackLayout>
            <Label Text="Instructor: " FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
            <Label x:Name="InstuctorLabel"/>
        </HorizontalStackLayout>
        <HorizontalStackLayout>
            <Label Text="Phone: " FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
            <Label x:Name="PhoneLabel" />
        </HorizontalStackLayout>
        <HorizontalStackLayout>
            <Label Text="Email: " FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
            <Label x:Name="EmailLabel"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentView>
