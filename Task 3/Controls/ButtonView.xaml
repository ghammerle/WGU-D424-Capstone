<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="C424Assessment.Controls.ButtonView"
             x:Name="Root">
    <Grid
            Padding="5"
            RowDefinitions="50"
            RowSpacing="5"
            ColumnDefinitions="*,*,*"
            ColumnSpacing="5"
              >
        <Button x:Name="editButton" Clicked="editButton_Clicked" Text="Update\Save" Grid.Column="0" />
        <Button x:Name="DeleteButton" Clicked="DeleteButton_Clicked" Text="Delete" Grid.Column="1"/>
        <Button x:Name="cancelButton" Clicked="cancelButton_Clicked" Text="Cancel" Grid.Column="2" IsVisible="{Binding IsCancelVisible, Source={x:Reference Root}}"/>
    </Grid>
</ContentView>
