<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="C424Assessment.Controls.TermView"
             xmlns:models="clr-namespace:C424Assessment.Models;assembly=DataRepositoryClassLibrary"
             x:Name="RootView">
    
    <VerticalStackLayout Padding="20">
        <Label Text="Scheduled Dates"
                FontSize="18"
                FontAttributes="Bold"
                HorizontalOptions="Center"/>
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" Padding="5">
            <Label Text="Start Date" VerticalOptions="Center" HorizontalOptions="Start"/>
            <DatePicker  x:Name="StartDatePicker" Date="{Binding StartDate}" HorizontalOptions="Fill" WidthRequest="100"/>
            <Label  Text="End Date"  VerticalOptions="Center" HorizontalOptions="Start" HorizontalTextAlignment="End"/>
            <DatePicker x:Name="EndDatePicker" Date="{Binding EndDate}" HorizontalOptions="Fill" WidthRequest="100"/>
        </HorizontalStackLayout>
        <Label Text="Courses"
           FontSize="24"
           FontAttributes="Bold"
           HorizontalOptions="Center" />
        <ListView
            x:Name="listCourses"
            ItemsSource="{Binding Courses}"
             Background="Transparent"
             SeparatorColor="Silver"
             RowHeight="65"
              ItemSelected="listCourses_ItemSelected"
            ItemTapped="listCourses_ItemTapped">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell
                        Text="{Binding Name}">
                        <!--Detail="{Binding Status}"-->
                    </TextCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </VerticalStackLayout>
</ContentView>